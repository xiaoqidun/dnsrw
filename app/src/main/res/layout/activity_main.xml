<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/service_status_card"
            style="@style/DnsRw.StatusCard"
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="0dp">

                <ImageView
                    android:id="@+id/service_status_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_link_24"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/service_status"
                    style="@style/DnsRw.Status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/service_waiting" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_button"
                    style="@style/DnsRw.StatusButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/theme_color"
                    android:tooltipText="@string/theme_color"
                    app:icon="@drawable/ic_palette_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/about_button"
                    style="@style/DnsRw.StatusButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/about"
                    android:tooltipText="@string/about"
                    app:icon="@drawable/ic_info_24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="0dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_dns_24"
                app:tint="?attr/colorPrimary" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/DnsRw.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/defaults_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_defaults"
                style="@style/DnsRw.AddButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/save_defaults"
                android:enabled="false"
                android:tooltipText="@string/save_defaults"
                app:icon="@drawable/ic_save_24" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/DnsRw.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wifi_24"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/DnsRw.NetworkTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/wireless_network" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/DnsRw.DnsField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/primary_dns">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/wifi_default_dns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-monospace"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/DnsRw.DnsField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/secondary_dns">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/wifi_default_dns_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-monospace"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/DnsRw.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mobile_24"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/DnsRw.NetworkTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/mobile_network" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/DnsRw.DnsField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/primary_dns">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/mobile_default_dns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-monospace"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/DnsRw.DnsField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/secondary_dns">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/mobile_default_dns_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-monospace"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="0dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi_24"
                app:tint="?attr/colorPrimary" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/DnsRw.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/wifi_rules_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_wifi_rule"
                style="@style/DnsRw.AddButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/add_wireless_rewrite"
                android:enabled="false"
                android:tooltipText="@string/add_wireless_rewrite"
                app:icon="@drawable/ic_add_24" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wifi_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="0dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mobile_24"
                app:tint="?attr/colorPrimary" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/DnsRw.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/sim_rules_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_sim_rule"
                style="@style/DnsRw.AddButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/add_mobile_rewrite"
                android:enabled="false"
                android:tooltipText="@string/add_mobile_rewrite"
                app:icon="@drawable/ic_add_24" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sim_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
