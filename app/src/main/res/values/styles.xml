<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DnsRw" parent="Theme.Material3.Light.NoActionBar">
        <item name="dynamicColorThemeOverlay">@style/ThemeOverlay.Material3.DynamicColors.Light</item>
        <item name="materialAlertDialogTheme">@style/DnsRw.AlertDialog</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">?android:attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?android:attr/isLightTheme</item>
    </style>

    <style name="DnsRw.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/DnsRw.DialogSurface</item>
        <item name="buttonBarButtonStyle">@style/DnsRw.DialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/DnsRw.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DnsRw.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DnsRw.DialogButton</item>
    </style>

    <style name="DnsRw.DialogSurface" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/DnsRw.DialogShape</item>
    </style>

    <style name="DnsRw.DialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="DnsRw.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="DnsRw.Status" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="DnsRw.StatusCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="DnsRw.AboutRow" parent="">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="DnsRw.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="DnsRw.RuleCard" parent="DnsRw.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <style name="DnsRw.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="DnsRw.NetworkTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="DnsRw.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:gravity">center</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:padding">8dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <style name="DnsRw.AddButton" parent="DnsRw.IconButton">
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <style name="DnsRw.StatusButton" parent="DnsRw.IconButton">
        <item name="iconTint">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="DnsRw.EditButton" parent="DnsRw.IconButton">
        <item name="iconSize">22dp</item>
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <style name="DnsRw.DeleteButton" parent="DnsRw.IconButton">
        <item name="iconTint">?attr/colorError</item>
    </style>

    <style name="DnsRw.DnsField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
    </style>
</resources>
